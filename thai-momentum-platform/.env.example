# Prisma SQLite — path สัมพัทธ์กับโฟลเดอร์ prisma/ (ไฟล์ demo snapshot อยู่ที่ db/custom.db)
DATABASE_URL="file:../db/custom.db"

# ============================================================
# ความปลอดภัย (src/proxy.ts + src/lib/security/) — ไม่ตั้งอะไรเลย = โหมด local
# ------------------------------------------------------------
# โหมด local (ค่าเริ่มต้น): เปิด http://localhost:3000 บนเครื่องที่รันเซิร์ฟเวอร์ได้เหมือนเดิม ไม่ต้องเข้าสู่ระบบ
#   เครื่องอื่น (IP ใน LAN / โดเมน / reverse proxy) ได้ 403 พร้อมวิธีตั้งรหัสผ่าน
#   ⚠️ proxy ของ Next มองไม่เห็น socket address — ผู้โจมตีใน LAN ที่ปลอม Host/X-Forwarded-For เองอาจผ่านได้
#   ถ้าพอร์ตเปิดให้เครื่องอื่นเห็น ให้ bind เฉพาะ loopback: HOSTNAME=127.0.0.1 (standalone) / next dev -H 127.0.0.1
#   หรือตั้ง TMP_AUTH_PASSWORD ทุกครั้งที่ต้องเปิดออกนอกเครื่อง
# โหมด auth: ตั้ง TMP_AUTH_PASSWORD → ทุกหน้าและทุก API ต้องเข้าสู่ระบบที่ /login (หรือใช้ Bearer token)
#   ยกเว้น /login, /terms, /api/auth/*, /api/health และไฟล์ static
# ทุกโหมด: POST/PUT/PATCH/DELETE ที่ /api/* ต้องเป็น JSON (Content-Type: application/json) และมาจาก origin เดียวกัน
#   (กัน CSRF) · งานหนัก/เรียก LLM/ดึงข้อมูลภายนอกถูกจำกัดความถี่ต่อ client (429 + Retry-After)
# ============================================================

# รหัสผ่านผู้ดูแล (สิทธิ์เต็ม) — ตั้งแล้วเข้าโหมด auth · ใช้รหัสยาวแบบสุ่ม ≥ 12 ตัวอักษร
# TMP_AUTH_PASSWORD="change-me-to-a-long-random-passphrase"

# รหัสผ่านผู้ชม (ไม่บังคับ) — อ่านอย่างเดียว: GET/HEAD เท่านั้น, POST/PUT/DELETE ได้ 403
# ใช้ได้เฉพาะเมื่อมี TMP_AUTH_PASSWORD และต้องไม่ซ้ำกับรหัสผู้ดูแล
# TMP_VIEWER_PASSWORD=""

# คีย์ HMAC-SHA256 สำหรับลงนาม session cookie (อายุ 7 วัน) — สร้างด้วย: openssl rand -hex 32
# ไม่ตั้ง = อนุพันธ์จากรหัสผ่านอัตโนมัติ (PBKDF2) พร้อมคำเตือนตอนเริ่มระบบ · หมุนค่านี้ = ออกจากระบบทุกคนทันที
# (เปลี่ยนรหัสผ่านของบทบาทใด = session ของบทบาทนั้นใช้ไม่ได้ทันทีเช่นกัน)
# TMP_AUTH_SECRET=""

# Bearer token สำหรับสคริปต์/cron (สิทธิ์ผู้ดูแล เฉพาะ /api/*) — สร้างด้วย: openssl rand -hex 32
#   curl -H "Authorization: Bearer $TMP_API_TOKEN" -H "Content-Type: application/json" -d @body.json http://host:3000/api/feed/ingest
# สคริปต์ lab/fetch_set_feed.py และ lab/fetch_settrade_feed.py ส่ง header นี้ให้เองเมื่อมี env TMP_API_TOKEN
# TMP_API_TOKEN=""

# ⚠️ ไม่ปลอดภัย: ให้เครื่องอื่นเข้าได้โดยไม่มีรหัสผ่าน (โหมด local เท่านั้น) — ใครเข้าถึงพอร์ตได้ ลบ/แก้ข้อมูลได้ทั้งหมด
# ใช้เฉพาะในเครือข่ายที่ควบคุมเองทั้งหมด เช่น container ที่มี reverse proxy ทำ auth ให้แล้ว
# TMP_ALLOW_REMOTE_NOAUTH=0

# origin เพิ่มเติมที่ส่งคำขอแก้ไขข้อมูลได้ (คั่นด้วย ,) — ใช้เมื่อ reverse proxy เปลี่ยน Host และไม่ส่ง X-Forwarded-Host
# ปกติไม่ต้องตั้ง (ตรวจ Origin เทียบกับ Host / X-Forwarded-Host ให้อยู่แล้ว)
# TMP_ALLOWED_ORIGINS="https://tmp.example.com"

# ส่ง Strict-Transport-Security (1 ปี) เมื่อคำขอมาทาง https — เปิดเฉพาะหลัง reverse proxy ที่มีใบรับรองที่ browser เชื่อถือ
# (ใบรับรอง self-signed + HSTS = browser ไม่ให้กดข้ามคำเตือน → เข้าเว็บไม่ได้)
# TMP_HSTS=0

# ============================================================
# สำรองข้อมูล (src/lib/ops/backup.ts) — SQLite VACUUM INTO ก่อน seed / replaceDemo / นำเข้าที่ทับข้อมูลเดิม
# ============================================================
# โฟลเดอร์เก็บไฟล์สำรอง (ค่าเริ่มต้น <app>/data/backups — อยู่ใน .gitignore) · เก็บ 14 ไฟล์ล่าสุด
# ไฟล์สำรองคือข้อมูลทั้งหมด → ตั้งสิทธิ์ 600 ให้อัตโนมัติ ควรคัดลอกออกนอกเครื่องเป็นระยะ
# TMP_BACKUP_DIR="/var/backups/thai-momentum-platform"

# ============================================================
# รันไทม์ / ops (เขียนตามโค้ดของ slice อื่น ณ ตอนรวมงาน — ค่าเริ่มต้นใช้ได้เลย)
# ============================================================
# พอร์ต/ที่อยู่ที่ standalone server ฟัง (node .next/standalone/server.js) — ใช้งานบนเครื่องตัวเองให้ bind 127.0.0.1
# PORT=3000
# HOSTNAME=127.0.0.1

# ระดับ log ของสคริปต์/ops (src/lib/ops/log.ts): debug | info | warn | error (ค่าเริ่มต้น info)
# LOG_LEVEL=info

# ไฟล์วันหยุด SET ของผู้ใช้ (JSON เช่น ["2027-01-01", ...]) แทนปฏิทินตั้งต้นในโค้ด — ตรวจกับประกาศ SET ทุกปี
# SET_HOLIDAYS_FILE="/path/to/set-holidays.json"

# URL ของแอปที่กำลังรัน ให้สคริปต์ใช้ตรวจ/เรียก (restore-db ตรวจว่า server หยุดแล้ว · scheduler อุ่น cache ด้วย TMP_API_TOKEN)
# TMP_APP_URL="http://127.0.0.1:3000"

# commit ที่ build (แสดงใน /api/health) — ตั้งตอน build image
# TMP_GIT_SHA=""

# docker compose เท่านั้น: พอร์ตบน loopback ของ host · tag ของ image · ฐานข้อมูลตั้งต้นใน volume ครั้งแรก (demo | empty | none)
# TMP_HOST_PORT=3000
# TMP_IMAGE_TAG=latest
# TMP_SEED_DB=demo

# ============================================================
# งานตามเวลา + สำรองข้อมูล (deploy/scheduler.ts · scripts/backup-db.ts — รายละเอียด docs/ops.md)
# ============================================================
# เก็บไฟล์สำรองกี่ชุด (ค่าเริ่มต้น 14) · สำเนาไปอีกดิสก์/NAS (แนะนำ — backup ในเครื่องเดียวกันไม่พอ)
# TMP_BACKUP_KEEP=14
# TMP_BACKUP_MIRROR_DIR="/mnt/nas/thai-momentum-backups"

# เวลาไทยของงานประจำวัน: daily (ดึงราคา → Jev → verify → track snapshot) จ.–ศ. 18:30 · backup ทุกวัน 02:30
# TMP_DAILY_AT=18:30
# TMP_DAILY_DAYS=1-5
# TMP_BACKUP_AT=02:30
# TMP_BACKUP_DAYS=0-6

# ลองใหม่เฉพาะ exit code ชั่วคราวของ daily (1 error · 3 ดึงไม่ได้ · 5 ข้อมูลยังไม่มา · 124 timeout)
# TMP_JOB_RETRIES=2
# TMP_JOB_RETRY_DELAY_MIN=20
# TMP_JOB_TIMEOUT_MIN=90
# TMP_DAILY_RETRY_CODES=1,3,5,124

# dead-man's switch แบบ healthchecks.io: สำเร็จ = GET url · ล้มเหลว = GET url/fail
# TMP_PING_DAILY_URL=""
# TMP_PING_BACKUP_URL=""
