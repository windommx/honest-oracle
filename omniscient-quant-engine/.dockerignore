# build context ของ Dockerfile = โฟลเดอร์นี้ — ส่งเฉพาะสิ่งที่ build ต้องใช้ (เร็วขึ้น + ไม่มีความลับ/ข้อมูลผู้ใช้หลุดเข้า image)
# db/custom.db ต้องอยู่ใน context (เป็น seed ของ volume /data)

node_modules
.next
out
build
*.tsbuildinfo
next-env.d.ts

# ความลับ — ส่งเข้า container ตอนรันผ่าน env_file / environment เท่านั้น
.env
.env.*
!.env.example
.z-ai-config

# ข้อมูลที่เกิดตอนใช้งาน
db/*.db-journal
db/*.db-wal
db/*.db-shm
data/backups
*.log

