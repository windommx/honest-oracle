# ============================================================
# Omniscient Quant Engine — ตัวอย่างการตั้งค่า (คัดลอกเป็น .env แล้วแก้ค่า)
# ค่าเริ่มต้นทั้งหมดใช้ได้ทันทีบนเครื่องตัวเอง: เปิด http://localhost:3000 โดยไม่ต้องตั้งรหัสผ่าน
# ============================================================

# Prisma SQLite — path สัมพัทธ์กับโฟลเดอร์ prisma/ (ไฟล์ demo snapshot อยู่ที่ db/custom.db)
# โหมด standalone (bun run start) ควรใช้ absolute path: DATABASE_URL="file:/abs/path/omniscient-quant-engine/db/custom.db"
DATABASE_URL="file:../db/custom.db"

# ============================================================
# LLM (ใช้เฉพาะ 3 จุด: หลอมรวมด้วย AI · AI Auditor · แชท AI Analyst) — ไม่ตั้ง = ปุ่มเหล่านั้นตอบ 503 พร้อมข้อความบอกวิธีตั้งค่า
# เอนจินวิเคราะห์ทั้งหมด (gates, backtest, synthesis score, meta-risk, apex) ทำงานโดยไม่ต้องใช้ LLM
# ------------------------------------------------------------
# ทางที่ 1: endpoint แบบ OpenAI-compatible (OpenAI, Azure/OpenRouter/Groq/Ollama/vLLM ฯลฯ ที่มี /v1/chat/completions)
#   OQE_LLM_API_KEY + OQE_LLM_MODEL บังคับ · OQE_LLM_BASE_URL ไม่ตั้ง = https://api.openai.com/v1
# OQE_LLM_API_KEY=""
# OQE_LLM_MODEL=""
# OQE_LLM_BASE_URL="https://api.openai.com/v1"
# ทางที่ 2: z-ai-web-dev-sdk (ต้นฉบับพัฒนาบน container ของ z.ai) — วางไฟล์ .z-ai-config ({"baseUrl":..., "apiKey":...})
#   ในโฟลเดอร์แอป, home directory หรือ /etc แล้วระบบจะใช้เองเมื่อไม่ได้ตั้งทางที่ 1
# บังคับเลือกผู้ให้บริการ: auto (ค่าเริ่มต้น) | openai | zai | none
# OQE_LLM_PROVIDER=auto
# เวลารอสูงสุดต่อคำขอ (มิลลิวินาที) — ค่าเริ่มต้น 90000
# OQE_LLM_TIMEOUT_MS=90000

# ============================================================
# ความปลอดภัย (src/proxy.ts + src/lib/security/) — ไม่ตั้งอะไรเลย = โหมด local
# ------------------------------------------------------------
# โหมด local (ค่าเริ่มต้น): รับเฉพาะคำขอจากเครื่องที่รันเซิร์ฟเวอร์ (http://localhost) · เครื่องอื่นได้ 403 พร้อมวิธีตั้งรหัสผ่าน
#   dev/start ฟังเฉพาะ 127.0.0.1 อยู่แล้ว — ถ้าจะฟัง 0.0.0.0 ให้ตั้งรหัสผ่านก่อนเสมอ
# โหมด auth: ตั้ง OQE_AUTH_PASSWORD → ทุกหน้าและทุก API ต้องส่ง HTTP Basic auth (browser จะถามรหัสเอง ชื่อผู้ใช้ใส่อะไรก็ได้)
#   ยกเว้น /api/health และไฟล์ static · ใช้งานผ่านอินเทอร์เน็ตต้องมี TLS reverse proxy ด้านหน้า (Basic auth บน http ธรรมดา = รหัสวิ่งเป็นตัวอักษรเปล่า)
# ทุกโหมด: POST/PUT/PATCH/DELETE ที่ /api/* ต้องเป็น JSON และมาจาก origin เดียวกัน (กัน CSRF) · เส้นทางที่เรียก LLM/รีเซ็ตข้อมูล
#   จำกัดความถี่ต่อ client (429 + Retry-After)
# ============================================================

# รหัสผ่านผู้ดูแล — ตั้งแล้วเข้าโหมด auth · ใช้รหัสยาวแบบสุ่ม ≥ 12 ตัวอักษร
# OQE_AUTH_PASSWORD=""

# Bearer token สำหรับสคริปต์/cron/monitor (เฉพาะ /api/*) — สร้างด้วย: openssl rand -hex 32
#   curl -H "Authorization: Bearer $OQE_API_TOKEN" http://host:3000/api/board
# OQE_API_TOKEN=""

# ⚠️ ไม่ปลอดภัย: ให้เครื่องอื่นเข้าได้โดยไม่มีรหัสผ่าน (โหมด local เท่านั้น) — ใครเข้าถึงพอร์ตได้ แก้ journal/รีเซ็ตข้อมูล/ใช้โควตา LLM ได้
# OQE_ALLOW_REMOTE_NOAUTH=0

# origin เพิ่มเติมที่ส่งคำขอแก้ไขข้อมูลได้ (คั่นด้วย ,) — ใช้เมื่อ reverse proxy เปลี่ยน Host และไม่ส่ง X-Forwarded-Host
# OQE_ALLOWED_ORIGINS="https://oqe.example.com"

# ส่ง Strict-Transport-Security (1 ปี) เมื่อคำขอมาทาง https — เปิดเฉพาะหลัง reverse proxy ที่มีใบรับรองที่ browser เชื่อถือ
# OQE_HSTS=0

# ============================================================
# รันไทม์ (standalone server: node .next/standalone/server.js)
# ============================================================
# PORT=3000
# HOSTNAME=127.0.0.1
# commit ที่ build (แสดงใน /api/health) — ตั้งตอน build image
# OQE_GIT_SHA=""
