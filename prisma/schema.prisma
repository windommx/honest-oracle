generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  plan      String   @default("free")
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  analyses  Analysis[]
  corporateAnalyses CorporateAnalysis[]
  childAnalyses ChildAnalysis[]
  renameAnalyses RenameAnalysis[]
  oracleReadings OracleReading[]
  apiKeys   ApiKey[]
  usage     UsageDay[]
  subscription Subscription?
  rushProjects RushProject[]
  therapyAssessments TherapyAssessment[]
  therapySessions    TherapySession[]
  therapySleepNights TherapySleepNight[]
}

model Analysis {
  id           String   @id @default(cuid())
  userId       String?
  firstName    String
  lastName     String
  birthday     String
  totalScore   Float
  kalaiganiScore Float
  numerologyScore Float
  taksaScore   Float
  phoneticScore Float
  elementScore Float
  details      String
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id])
}

model CorporateAnalysis {
  id              String   @id @default(cuid())
  userId          String?
  brandName       String
  founderBirthday String
  industryType    String
  targetAudience  String
  cai             Float
  s1              Float
  s2              Float
  s3              Float
  elementBalance  Float
  phoneticPricing String
  memorabilityScore Float
  resonanceTriangle String
  warnings        String
  recommendations String
  createdAt      DateTime @default(now())
  user           User?    @relation(fields: [userId], references: [id])
}

model ChildAnalysis {
  id                 String   @id @default(cuid())
  userId             String?
  gender             String
  birthDay           String
  parentGoals        String
  recommendedLetters String
  avoidedLetters     String
  targetNumber       Int
  ayatana            Int
  warakkasaEmphasis  String
  suggestedNames     String
  createdAt          DateTime @default(now())
  user               User?    @relation(fields: [userId], references: [id])
}

model RenameAnalysis {
  id                   String   @id @default(cuid())
  userId               String?
  currentName          String
  currentSurname       String
  birthDay             String
  goals                String
  problemAreas         String
  targetNumber         Int
  targetAyatana        Int
  recommendedWarakkasa String
  suggestedNewNames    String
  softTransitionTips   String
  createdAt            DateTime @default(now())
  user                 User?    @relation(fields: [userId], references: [id])
}

model OracleReading {
  id          String   @id @default(cuid())
  userId      String?
  inputName   String
  birthDate   DateTime
  birthTime   String?
  birthPlace  String?
  result      Json
  visibility  String   @default("private")
  shareToken  String   @unique
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])
}

model ApiKey {
  id         String   @id @default(cuid())
  userId     String
  label      String
  prefix     String
  keyHash    String   @unique
  createdAt  DateTime @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  user       User     @relation(fields: [userId], references: [id])
}

model Subscription {
  id                   String   @id @default(cuid())
  userId               String   @unique
  provider             String
  plan                 String
  status               String
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean  @default(false)
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user                 User     @relation(fields: [userId], references: [id])
}

model UsageDay {
  id         String   @id @default(cuid())
  userId     String
  day        DateTime
  oracleReads Int     @default(0)
  apiCalls   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, day])
}

// A saved Rush Engine project: the book configuration. Prompts are derived
// deterministically from the config, so only the config is persisted.
model RushProject {
  id          String   @id @default(cuid())
  userId      String
  title       String
  type        String
  subGenre    String
  config      Json
  visibility  String   @default("private")
  shareToken  String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User                  @relation(fields: [userId], references: [id])
  versions    RushProjectVersion[]
}

// Immutable config snapshot taken on each save — version history / restore.
model RushProjectVersion {
  id         String   @id @default(cuid())
  projectId  String
  config     Json
  createdAt  DateTime @default(now())

  project    RushProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ── MindBridge (music therapy) ────────────────────────────────────────────────
// One completed administration of a screening instrument.
//
// `responses` is the source of truth and `total`/`band` are stored derivations:
// the API re-scores every submission through lib/therapy-engine rather than
// trusting a client-supplied total, so a score in this table can always be
// re-derived from the answers beside it.
model TherapyAssessment {
  id         String   @id @default(cuid())
  userId     String
  // "gad7" | "phq9" — the instrument the responses belong to.
  instrument String
  // number[] — one entry per item, in item order.
  responses  Json
  total      Int
  band       String
  // Set when a safety-critical item was endorsed (PHQ-9 item 9), independent of total.
  safetyFlag Boolean  @default(false)
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, instrument, createdAt])
}

// A completed listening or breathing session. Adherence data — what was actually
// done, not what was recommended.
model TherapySession {
  id            String   @id @default(cuid())
  userId        String
  // "music" | "breath"
  kind          String
  // Iso-principle ramp endpoints, for a music session.
  startBpm      Int?
  targetBpm     Int?
  // Breath pattern id, for a breathing session.
  breathPattern String?
  plannedMin    Int
  completedMin  Int
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// One night of the sleep diary. Raw reported quantities only — total sleep time
// and sleep efficiency are computed by sleep.ts on read, never stored, so the
// stored row cannot drift from the formula that derives them.
model TherapySleepNight {
  id                     String   @id @default(cuid())
  userId                 String
  // YYYY-MM-DD, the morning being reported.
  date                   String
  timeInBedMin           Int
  sleepLatencyMin        Int
  wakeAfterSleepOnsetMin Int
  terminalWakefulnessMin Int
  awakenings             Int
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}
