generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  plan      String   @default("free")
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  analyses  Analysis[]
  corporateAnalyses CorporateAnalysis[]
  childAnalyses ChildAnalysis[]
  renameAnalyses RenameAnalysis[]
  oracleReadings OracleReading[]
  apiKeys   ApiKey[]
  usage     UsageDay[]
  subscription Subscription?
  rushProjects RushProject[]
  competencyNurses CompetencyNurse[]
}

model Analysis {
  id           String   @id @default(cuid())
  userId       String?
  firstName    String
  lastName     String
  birthday     String
  totalScore   Float
  kalaiganiScore Float
  numerologyScore Float
  taksaScore   Float
  phoneticScore Float
  elementScore Float
  details      String
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id])
}

model CorporateAnalysis {
  id              String   @id @default(cuid())
  userId          String?
  brandName       String
  founderBirthday String
  industryType    String
  targetAudience  String
  cai             Float
  s1              Float
  s2              Float
  s3              Float
  elementBalance  Float
  phoneticPricing String
  memorabilityScore Float
  resonanceTriangle String
  warnings        String
  recommendations String
  createdAt      DateTime @default(now())
  user           User?    @relation(fields: [userId], references: [id])
}

model ChildAnalysis {
  id                 String   @id @default(cuid())
  userId             String?
  gender             String
  birthDay           String
  parentGoals        String
  recommendedLetters String
  avoidedLetters     String
  targetNumber       Int
  ayatana            Int
  warakkasaEmphasis  String
  suggestedNames     String
  createdAt          DateTime @default(now())
  user               User?    @relation(fields: [userId], references: [id])
}

model RenameAnalysis {
  id                   String   @id @default(cuid())
  userId               String?
  currentName          String
  currentSurname       String
  birthDay             String
  goals                String
  problemAreas         String
  targetNumber         Int
  targetAyatana        Int
  recommendedWarakkasa String
  suggestedNewNames    String
  softTransitionTips   String
  createdAt            DateTime @default(now())
  user                 User?    @relation(fields: [userId], references: [id])
}

model OracleReading {
  id          String   @id @default(cuid())
  userId      String?
  inputName   String
  birthDate   DateTime
  birthTime   String?
  birthPlace  String?
  result      Json
  visibility  String   @default("private")
  shareToken  String   @unique
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])
}

model ApiKey {
  id         String   @id @default(cuid())
  userId     String
  label      String
  prefix     String
  keyHash    String   @unique
  createdAt  DateTime @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  user       User     @relation(fields: [userId], references: [id])
}

model Subscription {
  id                   String   @id @default(cuid())
  userId               String   @unique
  provider             String
  plan                 String
  status               String
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean  @default(false)
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user                 User     @relation(fields: [userId], references: [id])
}

model UsageDay {
  id         String   @id @default(cuid())
  userId     String
  day        DateTime
  oracleReads Int     @default(0)
  apiCalls   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, day])
}

// A saved Rush Engine project: the book configuration. Prompts are derived
// deterministically from the config, so only the config is persisted.
model RushProject {
  id          String   @id @default(cuid())
  userId      String
  title       String
  type        String
  subGenre    String
  config      Json
  visibility  String   @default("private")
  shareToken  String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User                  @relation(fields: [userId], references: [id])
  versions    RushProjectVersion[]
}

// Immutable config snapshot taken on each save — version history / restore.
model RushProjectVersion {
  id         String   @id @default(cuid())
  projectId  String
  config     Json
  createdAt  DateTime @default(now())

  project    RushProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ── HD Competency — hemodialysis-nurse competency assessment ────────────────
// A nurse belongs to the account that created them (the unit head), so a unit's
// roster is private to that login. Scores are the raw form: a JSON map
// criterionId ("1".."10") → point (1-5). totalScore and level are DERIVED by
// lib/competency/scoring.ts on every write and stored only so lists and stats can
// query them without re-parsing JSON; they are never accepted from a client.
model CompetencyNurse {
  id          String   @id @default(cuid())
  userId      String
  fullName    String
  nickname    String?
  position    String   @default("พยาบาลวิชาชีพ")
  // ระดับบริหาร from the OUTCOME sheet: 6 = หัวหน้าแผนก (Top Manager), 7 = ผู้จัดการศูนย์
  // (Director). Assigned by role, never computed from a score.
  mgmtLevel   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User                   @relation(fields: [userId], references: [id])
  assessments CompetencyAssessment[]

  @@index([userId])
}

model CompetencyAssessment {
  id         String   @id @default(cuid())
  nurseId    String
  assessDate DateTime @default(now())
  assessor   String?
  note       String?
  scores     Json
  totalScore Int
  level      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  nurse      CompetencyNurse @relation(fields: [nurseId], references: [id], onDelete: Cascade)

  @@index([nurseId, assessDate])
}
